+/* Fluorine: keep error diagnostics even when the game disables debug output.
+ * The file is opened only on failure, appended under a per-module lock and
+ * closed before returning, so a later game crash cannot lose stdio buffers.
+ */
+#define FAUDIO_ERROR_PATH_SIZE 4096
+static SRWLOCK error_log_lock = SRWLOCK_INIT;
+static WCHAR error_log_path[FAUDIO_ERROR_PATH_SIZE];
+
+static void error_log_append(char *out, size_t size, size_t *used, const char *fmt, ...)
+{
+	int count;
+	va_list args;
+	if (*used >= size - 1) return;
+	va_start(args, fmt);
+	count = FAudio_vsnprintf(out + *used, size - *used, fmt, args);
+	va_end(args);
+	if (count < 0 || (size_t) count >= size - *used)
+		*used = size - 1;
+	else
+		*used += count;
+	out[*used] = '\0';
+}
+
+static void error_log_utf8(const WCHAR *path, char *out, size_t size)
+{
+	if (!WideCharToMultiByte(CP_UTF8, 0, path, -1, out, size, NULL, NULL))
+		FAudio_snprintf(out, size, "%s", "<path unavailable>");
+}
+
+/* Accept a Windows absolute path or a Unix path through Wine's Z: drive. */
+static int error_log_directory(WCHAR *out, const WCHAR *variable, const WCHAR *suffix)
+{
+	WCHAR value[FAUDIO_ERROR_PATH_SIZE];
+	const WCHAR *path = value;
+	DWORD length = GetEnvironmentVariableW(variable, value, FAUDIO_ERROR_PATH_SIZE);
+	size_t prefix, i;
+	if (!length || length >= FAUDIO_ERROR_PATH_SIZE) return 0;
+	/* Older Wine exposes the Unix home as an NT path in WINEHOMEDIR. */
+	if (!wcsncmp(value, L"\\??\\unix\\", 9)) path = value + 8;
+	else if (!wcsncmp(value, L"\\??\\", 4)) path = value + 4;
+	length = wcslen(path);
+	prefix = path[0] == '/' || path == value + 8 ? 2 : 0;
+	if (!prefix && !(length > 2 && path[1] == ':' &&
+		(path[2] == '\\' || path[2] == '/')) &&
+		!(path[0] == '\\' && path[1] == '\\')) return 0;
+	if (prefix + length + wcslen(suffix) + 1 > FAUDIO_ERROR_PATH_SIZE) return 0;
+	if (prefix) { out[0] = 'Z'; out[1] = ':'; }
+	wcscpy(out + prefix, path);
+	wcscat(out, suffix);
+	for (i = 0; out[i]; ++i)
+		if (out[i] == '/') out[i] = '\\';
+	return 1;
+}
+
+static int error_log_mkdirs(WCHAR *path)
+{
+	size_t i = 3;
+	DWORD attributes;
+	if (path[0] == '\\' && path[1] == '\\')
+	{
+		/* The server and share must already exist. */
+		i = 2;
+		while (path[i] && path[i] != '\\') ++i;
+		if (path[i]) ++i;
+		while (path[i] && path[i] != '\\') ++i;
+		if (path[i]) ++i;
+	}
+	for (; path[i]; ++i)
+	{
+		if (path[i] != '\\') continue;
+		path[i] = 0;
+		CreateDirectoryW(path, NULL);
+		attributes = GetFileAttributesW(path);
+		path[i] = '\\';
+		if (attributes == INVALID_FILE_ATTRIBUTES || !(attributes & FILE_ATTRIBUTE_DIRECTORY)) return 0;
+	}
+	CreateDirectoryW(path, NULL);
+	attributes = GetFileAttributesW(path);
+	return attributes != INVALID_FILE_ATTRIBUTES && (attributes & FILE_ATTRIBUTE_DIRECTORY);
+}
+
+static const WCHAR *error_log_basename(const WCHAR *path)
+{
+	const WCHAR *base = wcsrchr(path, '\\');
+	return base ? base + 1 : path;
+}
+
+static HANDLE error_log_open(const WCHAR *exe, const WCHAR *module, const SYSTEMTIME *now)
+{
+	WCHAR directory[FAUDIO_ERROR_PATH_SIZE], filename[512];
+	HANDLE handle;
+	unsigned int candidate;
+	if (error_log_path[0])
+	{
+		handle = CreateFileW(error_log_path, FILE_APPEND_DATA, FILE_SHARE_READ,
+			NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+		if (handle != INVALID_HANDLE_VALUE) return handle;
+		error_log_path[0] = 0;
+	}
+	_snwprintf(filename, sizeof(filename) / sizeof(*filename),
+		L"%ls-%04u%02u%02uT%02u%02u%02u%03uZ-pid%lu-%ls.log",
+		error_log_basename(exe), now->wYear, now->wMonth, now->wDay,
+		now->wHour, now->wMinute, now->wSecond, now->wMilliseconds,
+		GetCurrentProcessId(), error_log_basename(module));
+	filename[sizeof(filename) / sizeof(*filename) - 1] = 0;
+	for (candidate = 0; candidate < 8; ++candidate)
+	{
+		int valid;
+		switch (candidate)
+		{
+		case 0: valid = error_log_directory(directory, L"FLUORINE_AUDIO_LOG_DIR", L""); break;
+		/* Wine 11 renames host HOME/XDG variables; Wine 10 uses WINEHOMEDIR. */
+		case 1: valid = error_log_directory(directory, L"WINE_HOST_XDG_DATA_HOME", L"/fluorine/logs/audio"); break;
+		case 2: valid = error_log_directory(directory, L"XDG_DATA_HOME", L"/fluorine/logs/audio"); break;
+		case 3: valid = error_log_directory(directory, L"WINE_HOST_HOME", L"/.local/share/fluorine/logs/audio"); break;
+		case 4: valid = error_log_directory(directory, L"HOME", L"/.local/share/fluorine/logs/audio"); break;
+		case 5: valid = error_log_directory(directory, L"WINEHOMEDIR", L"/.local/share/fluorine/logs/audio"); break;
+		case 6: valid = error_log_directory(directory, L"LOCALAPPDATA", L"\\Fluorine\\logs\\audio"); break;
+		default: valid = error_log_directory(directory, L"TEMP", L"\\Fluorine\\logs\\audio"); break;
+		}
+		if (!valid || wcslen(directory) + wcslen(filename) + 2 > FAUDIO_ERROR_PATH_SIZE ||
+			!error_log_mkdirs(directory)) continue;
+		wcscpy(error_log_path, directory);
+		wcscat(error_log_path, L"\\");
+		wcscat(error_log_path, filename);
+		handle = CreateFileW(error_log_path, FILE_APPEND_DATA, FILE_SHARE_READ,
+			NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+		if (handle != INVALID_HANDLE_VALUE) return handle;
+	}
+	error_log_path[0] = 0;
+	return INVALID_HANDLE_VALUE;
+}
+
+void FAudio_INTERNAL_LogError(const char *file, uint32_t line, const char *func, const char *fmt, ...)
+{
+	char message[2048], record[32768], utf8[FAUDIO_ERROR_PATH_SIZE * 3];
+	WCHAR exe[FAUDIO_ERROR_PATH_SIZE], module[FAUDIO_ERROR_PATH_SIZE];
+	void *frames[32];
+	USHORT (WINAPI *capture)(ULONG, ULONG, void **, ULONG *);
+	USHORT count = 0, i;
+	MEMORY_BASIC_INFORMATION info;
+	SYSTEMTIME now;
+	HANDLE handle;
+	DWORD saved_error = GetLastError(), written;
+	size_t used = 0, offset = 0;
+	va_list args;
+	va_start(args, fmt);
+	FAudio_vsnprintf(message, sizeof(message), fmt, args);
+	va_end(args);
+	message[sizeof(message) - 1] = 0;
+	GetSystemTime(&now);
+	wcscpy(exe, L"unknown.exe");
+	wcscpy(module, L"faudio.dll");
+	GetModuleFileNameW(NULL, exe, FAUDIO_ERROR_PATH_SIZE);
+	if (VirtualQuery((const void *) FAudio_INTERNAL_LogError, &info, sizeof(info)))
+		GetModuleFileNameW((HMODULE) info.AllocationBase, module, FAUDIO_ERROR_PATH_SIZE);
+	exe[FAUDIO_ERROR_PATH_SIZE - 1] = module[FAUDIO_ERROR_PATH_SIZE - 1] = 0;
+	error_log_append(record, sizeof(record), &used,
+		"\n=== FAudio failure %04u-%02u-%02uT%02u:%02u:%02u.%03uZ pid=%lu tid=%lu ===\n",
+		now.wYear, now.wMonth, now.wDay, now.wHour, now.wMinute, now.wSecond,
+		now.wMilliseconds, GetCurrentProcessId(), GetCurrentThreadId());
+	error_log_utf8(exe, utf8, sizeof(utf8));
+	error_log_append(record, sizeof(record), &used, "executable=%s\n", utf8);
+	error_log_utf8(module, utf8, sizeof(utf8));
+	error_log_append(record, sizeof(record), &used,
+		"module=%s\nfaudio=%u.%u.%u architecture_bits=%u\nsource=%s:%u function=%s\nERROR: %s\n"
+		"asset_filename=unavailable (XAudio2 receives buffers, not file names)\ncall_stack:\n",
+		utf8, FAUDIO_MAJOR_VERSION, FAUDIO_MINOR_VERSION, FAUDIO_PATCH_VERSION,
+		(unsigned int) (sizeof(void*) * 8), file, line, func, message);
+	capture = (void *) GetProcAddress(GetModuleHandleW(L"ntdll.dll"), "RtlCaptureStackBackTrace");
+	if (capture) count = capture(0, 32, frames, NULL);
+	for (i = 0; i < count; ++i)
+	{
+		if (VirtualQuery(frames[i], &info, sizeof(info)) &&
+			GetModuleFileNameW((HMODULE) info.AllocationBase, module, FAUDIO_ERROR_PATH_SIZE))
+		{
+			module[FAUDIO_ERROR_PATH_SIZE - 1] = 0;
+			error_log_utf8(module, utf8, sizeof(utf8));
+			if (used + strlen(utf8) + 200 > sizeof(record))
+			{
+				error_log_append(record, sizeof(record), &used, "  <remaining stack truncated>\n");
+				break;
+			}
+			error_log_append(record, sizeof(record), &used, "  #%u %p %s+0x%" FAudio_PRIx64 "\n",
+				i, frames[i], utf8, (uint64_t) ((uintptr_t) frames[i] - (uintptr_t) info.AllocationBase));
+		}
+		else error_log_append(record, sizeof(record), &used, "  #%u %p <unknown module>\n", i, frames[i]);
+	}
+	if (!count) error_log_append(record, sizeof(record), &used, "  <stack unavailable>\n");
+	error_log_append(record, sizeof(record), &used, "=== end failure ===\n");
+	/* Keep debugger output as well; game TraceMask does not suppress failures. */
+	OutputDebugStringA(record);
+	/* Recover the logging module name: the stack loop reused this buffer. */
+	wcscpy(module, L"faudio.dll");
+	if (VirtualQuery((const void *) FAudio_INTERNAL_LogError, &info, sizeof(info)))
+		GetModuleFileNameW((HMODULE) info.AllocationBase, module, FAUDIO_ERROR_PATH_SIZE);
+	module[FAUDIO_ERROR_PATH_SIZE - 1] = 0;
+	AcquireSRWLockExclusive(&error_log_lock);
+	handle = error_log_open(exe, module, &now);
+	if (handle != INVALID_HANDLE_VALUE)
+	{
+		while (offset < used && WriteFile(handle, record + offset, used - offset, &written, NULL) && written)
+			offset += written;
+		CloseHandle(handle);
+	}
+	if (offset != used) OutputDebugStringA("FAudio: could not persist complete error log\n");
+	ReleaseSRWLockExclusive(&error_log_lock);
+	SetLastError(saved_error);
+}
