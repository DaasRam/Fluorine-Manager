+/* Invalid formats must never become live voices. Release builds disable
+ * the decoder-selection assertions below, so relying on those assertions
+ * leaves zero divisors and null decoders for the background mixer.
+ */
+static uint8_t validate_source_format(const FAudioWaveFormatEx *format)
+{
+	uint16_t tag;
+	if (format == NULL || format->nChannels == 0 ||
+		format->nChannels > FAUDIO_MAX_AUDIO_CHANNELS ||
+		format->nSamplesPerSec < FAUDIO_MIN_SAMPLE_RATE ||
+		format->nSamplesPerSec > FAUDIO_MAX_SAMPLE_RATE ||
+		format->nBlockAlign == 0)
+	{
+		return 0;
+	}
+
+	tag = format->wFormatTag;
+	if (tag == FAUDIO_FORMAT_EXTENSIBLE)
+	{
+		const FAudioWaveFormatExtensible *ext = (const FAudioWaveFormatExtensible*) format;
+		if (format->cbSize < sizeof(*ext) - sizeof(*format))
+			return 0;
+		if (!FAudio_memcmp(&ext->SubFormat, &DATAFORMAT_SUBTYPE_PCM, sizeof(FAudioGUID)))
+			tag = FAUDIO_FORMAT_PCM;
+		else if (!FAudio_memcmp(&ext->SubFormat, &DATAFORMAT_SUBTYPE_IEEE_FLOAT, sizeof(FAudioGUID)))
+			tag = FAUDIO_FORMAT_IEEE_FLOAT;
+		else if (!FAudio_memcmp(&ext->SubFormat, &DATAFORMAT_SUBTYPE_WMAUDIO2, sizeof(FAudioGUID)))
+			tag = FAUDIO_FORMAT_WMAUDIO2;
+		else if (!FAudio_memcmp(&ext->SubFormat, &DATAFORMAT_SUBTYPE_WMAUDIO3, sizeof(FAudioGUID)))
+			tag = FAUDIO_FORMAT_WMAUDIO3;
+		else if (!FAudio_memcmp(&ext->SubFormat, &DATAFORMAT_SUBTYPE_WMAUDIO_LOSSLESS, sizeof(FAudioGUID)))
+			tag = FAUDIO_FORMAT_WMAUDIO_LOSSLESS;
+		else
+			return 0;
+	}
+
+	switch (tag)
+	{
+	case FAUDIO_FORMAT_PCM:
+		if (format->wBitsPerSample != 8 && format->wBitsPerSample != 16 &&
+			format->wBitsPerSample != 24 && format->wBitsPerSample != 32)
+			return 0;
+		return format->nBlockAlign == format->nChannels * (format->wBitsPerSample / 8);
+	case FAUDIO_FORMAT_IEEE_FLOAT:
+		/* Preserve FAudio's PCM16-in-IEEE_FLOAT compatibility behavior. */
+		return (format->wBitsPerSample == 16 || format->wBitsPerSample == 32) &&
+			format->nBlockAlign == format->nChannels * (format->wBitsPerSample / 8);
+	case FAUDIO_FORMAT_MSADPCM:
+		return format->nChannels <= 2 && format->nBlockAlign / format->nChannels >= 7;
+#ifdef HAVE_WMADEC
+	case FAUDIO_FORMAT_WMAUDIO2:
+	case FAUDIO_FORMAT_WMAUDIO3:
+		return format->wBitsPerSample >= 8;
+	case FAUDIO_FORMAT_WMAUDIO_LOSSLESS:
+		return format->wFormatTag == FAUDIO_FORMAT_EXTENSIBLE && format->wBitsPerSample >= 8;
+	case FAUDIO_FORMAT_XMAUDIO2:
+	{
+		const FAudioXMA2WaveFormat *xma = (const FAudioXMA2WaveFormat*) format;
+		if (format->cbSize < sizeof(*xma) - sizeof(*format) || xma->wBlockCount == 0)
+			return 0;
+		return xma->dwSamplesEncoded / xma->wBlockCount != 0;
+	}
+#endif
+	default:
+		return 0;
+	}
+}
