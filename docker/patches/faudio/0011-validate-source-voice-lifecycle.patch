+uint8_t FAudio_INTERNAL_IsSourceVoiceValid(const FAudioSourceVoice *voice)
+{
+	const FAudioWaveFormatEx *format = voice->src.format;
+	if (format == NULL || format->nChannels == 0 || format->nBlockAlign == 0 ||
+		format->nSamplesPerSec < FAUDIO_MIN_SAMPLE_RATE ||
+		format->nSamplesPerSec > FAUDIO_MAX_SAMPLE_RATE)
+		return 0;
+#ifdef HAVE_WMADEC
+	if (voice->src.wmadec != NULL)
+		return 1;
+#endif
+	return voice->src.samples_per_block != 0 && voice->src.decode != NULL;
+}
