  </property>
  <property name="minimumSize">
   <size>
    <width>600</width>
    <height>460</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>Profiles</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout_3">
   <property name="spacing">
    <number>10</number>
   </property>
   <property name="leftMargin">
    <number>12</number>
   </property>
   <property name="topMargin">
    <number>12</number>
   </property>
   <property name="rightMargin">
    <number>12</number>
   </property>
   <property name="bottomMargin">
    <number>12</number>
   </property>
   <item>
    <layout class="QGridLayout" name="profileStatusLayout">
     <property name="horizontalSpacing">
      <number>8</number>
     </property>
     <property name="verticalSpacing">
      <number>3</number>
     </property>
     <item row="0" column="0">
      <widget class="QLabel" name="activeProfileLabel">
       <property name="text">
        <string>Current profile:</string>
       </property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QLabel" name="activeProfileNameLabel">
       <property name="textFormat">
        <enum>Qt::PlainText</enum>
       </property>
       <property name="text">
        <string>None</string>
       </property>
       <property name="toolTip">
        <string>The profile currently loaded by Fluorine.</string>
       </property>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QLabel" name="selectedProfileLabel">
       <property name="text">
        <string>Selected profile:</string>
       </property>
      </widget>
     </item>
     <item row="1" column="1">
      <widget class="QLabel" name="selectedProfileNameLabel">
       <property name="textFormat">
        <enum>Qt::PlainText</enum>
       </property>
       <property name="text">
        <string>None</string>
       </property>
       <property name="toolTip">
        <string>The profile selected in the list. Use the button below to switch to it.</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QLabel" name="profilesDescriptionLabel">
     <property name="wordWrap">
      <bool>true</bool>
     </property>
     <property name="text">
      <string>Profiles share installed mods but keep their own enabled mods and plugin order.</string>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="contentLayout">
     <property name="spacing">
      <number>12</number>
     </property>
     <item>
      <layout class="QVBoxLayout" name="profileListLayout">
       <item>
        <widget class="QListWidget" name="profilesList">
         <property name="toolTip">
          <string>List of profiles</string>
         </property>
         <property name="whatsThis">
          <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'MS Shell Dlg 2'; font-size:8pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Each profile has its own enabled mods and installation order, enabled plugins and load order, game INI files, and optional save game folder.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="selectionMode">
          <enum>QAbstractItemView::SingleSelection</enum>
         </property>
         <property name="uniformItemSizes">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QGridLayout" name="profileActionsLayout">
         <property name="horizontalSpacing">
          <number>8</number>
         </property>
         <property name="verticalSpacing">
          <number>6</number>
         </property>
         <item row="0" column="0">
          <widget class="QPushButton" name="addProfileButton">
           <property name="toolTip">
            <string>Create a new profile from scratch.</string>
           </property>
           <property name="whatsThis">
            <string>Create a new profile from scratch.</string>
           </property>
           <property name="text">
            <string>Create</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QPushButton" name="copyProfileButton">
           <property name="enabled">
            <bool>false</bool>
           </property>
           <property name="toolTip">
            <string>Duplicate the selected profile.</string>
           </property>
           <property name="whatsThis">
            <string>This creates a new profile with the same settings and active mods as the selected one.</string>
           </property>
           <property name="text">
            <string>Duplicate</string>
           </property>
          </widget>
         </item>
         <item row="1" column="0">
          <widget class="QPushButton" name="renameButton">
           <property name="enabled">
            <bool>false</bool>
           </property>
           <property name="toolTip">
            <string>Rename the selected profile.</string>
           </property>
           <property name="text">
            <string>Rename</string>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <widget class="QPushButton" name="removeProfileButton">
           <property name="enabled">
            <bool>false</bool>
           </property>
           <property name="toolTip">
            <string>Remove the selected profile and its local files.</string>
           </property>
           <property name="whatsThis">
            <string>Delete the selected profile. This cannot be undone.</string>
           </property>
           <property name="text">
            <string>Remove</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
      </layout>
     </item>
     <item>
      <layout class="QVBoxLayout" name="profileOptionsLayout">
       <item>
        <widget class="QGroupBox" name="profileOptionsGroup">
         <property name="title">
          <string>Selected profile options</string>
         </property>
         <layout class="QVBoxLayout" name="profileOptionsGroupLayout">
          <property name="spacing">
           <number>8</number>
          </property>
          <item>
           <widget class="QCheckBox" name="localSavesBox">
            <property name="toolTip">
             <string>If enabled, this profile uses its own save games.</string>
            </property>
            <property name="whatsThis">
             <string>If checked, save games are local to this profile and will not appear when starting with a different profile.</string>
            </property>
            <property name="text">
             <string>Use profile-specific save games</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="transferButton">
            <property name="enabled">
             <bool>false</bool>
            </property>
            <property name="toolTip">
             <string>Transfer save games to the selected profile.</string>
            </property>
            <property name="whatsThis">
             <string>Transfer save games to the selected profile.</string>
            </property>
            <property name="text">
             <string>Transfer saves</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="localIniFilesBox">
            <property name="toolTip">
             <string>Use profile-specific game INI files instead of the global INI files.</string>
            </property>
            <property name="whatsThis">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;If enabled, Fluorine uses this profile’s game INI files instead of the global INI files. Changes to these settings stay with this profile, while the global files can remain unchanged.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
            <property name="text">
             <string>Use profile-specific game INI files</string>
            </property>
            <property name="checked">
             <bool>false</bool>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="invalidationBox">
            <property name="toolTip">
             <string>Ensures data files from mods are used. Enable this unless you use another archive invalidation tool.</string>
            </property>
            <property name="whatsThis">
             <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'MS Shell Dlg 2'; font-size:8.25pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;The games Oblivion, Fallout 3 and Fallout NV contain a bug which prevents texture and mesh replacers (that is: all modifications to meshes and textures already in game) from working.&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Fluorine uses a workaround called &amp;quot;BSA redirection&amp;quot; to fix this issue. With Skyrim, it can still make sense to enable this option because file dates can affect whether a mod is active.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
            <property name="text">
             <string>Automatic archive invalidation</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="optionsHelpLabel">
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="text">
          <string>Changes save immediately. When enabled, saves and game INI settings stay with this profile. Other profiles can use their own settings.</string>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="profileOptionsSpacer">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>20</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="dialogButtonsLayout">
     <item>
      <spacer name="dialogButtonsSpacer">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>40</width>
         <height>20</height>
        </size>
       </property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="select">
       <property name="text">
        <string>Use profile</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="close">
       <property name="text">
        <string>Close</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
